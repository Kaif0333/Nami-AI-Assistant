{
  "name": "nami-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Nami AI Assistant foundation monorepo.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "check": "node scripts/check-foundation.mjs && node scripts/check-secrets.mjs",
    "check:foundation": "node scripts/check-foundation.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:secrets:history": "node scripts/check-secrets.mjs --history",
    "dev:api": "corepack pnpm --filter @nami/api dev",
    "build:api": "corepack pnpm --filter @nami/api build",
    "typecheck:api": "corepack pnpm --filter @nami/api typecheck",
    "db:generate": "corepack pnpm --filter @nami/api db:generate",
    "db:migrate:deploy": "corepack pnpm --filter @nami/api db:migrate:deploy",
    "db:validate": "corepack pnpm --filter @nami/api db:validate",
    "dev:web": "corepack pnpm --filter @nami/web-dashboard dev",
    "build:web": "corepack pnpm --filter @nami/web-dashboard build",
    "lint:web": "corepack pnpm --filter @nami/web-dashboard lint",
    "typecheck:web": "corepack pnpm --filter @nami/web-dashboard typecheck",
    "dev:desktop": "corepack pnpm --filter @nami/desktop dev",
    "build:desktop": "corepack pnpm --filter @nami/desktop build",
    "test:e2e": "corepack pnpm build:api && corepack pnpm build:web && corepack pnpm exec playwright test",
    "test:all": "corepack pnpm test && corepack pnpm test:e2e",
    "build": "corepack pnpm build:api && corepack pnpm build:web && corepack pnpm build:desktop",
    "lint": "corepack pnpm -r --if-present lint",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "serve": "14.2.6"
  }
}
