generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RiskLevel {
  low
  medium
  high
  blocked
}

enum ApprovalStatus {
  pending
  approved
  rejected
  expired
  completed
  failed
  cancelled
}

enum ActionLogStatus {
  planned
  approval_required
  approved
  rejected
  running
  completed
  failed
  cancelled
  blocked
}

enum MemoryType {
  profile
  project
  job
  client
  preference
  conversation
  document
  automation
  general
}

enum MemorySensitivity {
  public
  personal
  sensitive
}

enum MemoryStatus {
  active
  disabled
  archived
}

enum ResearchMode {
  fast
  deep
}

enum ResearchStatus {
  pending
  running
  completed
  partial
  failed
}

enum ResearchSourceType {
  web
  url_context
}

model UserProfile {
  id          String   @id @default(uuid()) @db.Uuid
  displayName String   @map("display_name")
  email       String?
  education   Json     @default("{}")
  skills      Json     @default("{}")
  preferences Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  title     String
  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  messages  Message[]

  @@index([createdAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  role           String
  content        String
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model ApprovalRequest {
  id             String         @id @default(uuid()) @db.Uuid
  actionType     String         @map("action_type")
  summary        String
  description    String         @default("")
  payloadPreview Json           @default("{}") @map("payload_preview")
  riskLevel      RiskLevel      @map("risk_level")
  status         ApprovalStatus @default(pending)
  requestedBy    String         @default("system") @map("requested_by")
  createdAt      DateTime       @default(now()) @map("created_at")
  approvedAt     DateTime?      @map("approved_at")
  rejectedAt     DateTime?      @map("rejected_at")
  completedAt    DateTime?      @map("completed_at")
  errorMessage   String?        @map("error_message")
  metadata       Json           @default("{}")
  actionLogs     ActionLog[]

  @@index([status, createdAt])
  @@index([riskLevel, createdAt])
  @@index([actionType])
  @@map("approval_requests")
}

model ActionLog {
  id            String           @id @default(uuid()) @db.Uuid
  commandId     String?          @map("command_id")
  approvalId    String?          @map("approval_id") @db.Uuid
  actionType    String           @map("action_type")
  summary       String
  status        ActionLogStatus  @default(planned)
  riskLevel     RiskLevel        @map("risk_level")
  inputPreview  Json             @default("{}") @map("input_preview")
  outputPreview Json             @default("{}") @map("output_preview")
  errorMessage  String?          @map("error_message")
  createdAt     DateTime         @default(now()) @map("created_at")
  startedAt     DateTime?        @map("started_at")
  completedAt   DateTime?        @map("completed_at")
  metadata      Json             @default("{}")
  approval      ApprovalRequest? @relation(fields: [approvalId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([riskLevel, createdAt])
  @@index([actionType])
  @@index([approvalId])
  @@map("action_logs")
}

model Memory {
  id          String             @id @default(uuid()) @db.Uuid
  type        MemoryType
  title       String
  content     String
  tags        String[]           @default([])
  source      String             @default("manual")
  sensitivity MemorySensitivity  @default(personal)
  status      MemoryStatus       @default(active)
  metadata    Json               @default("{}")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  embeddings  MemoryEmbedding[]

  @@index([type, status])
  @@index([sensitivity, status])
  @@index([updatedAt])
  @@map("memories")
}

model MemoryEmbedding {
  id        String                    @id @default(uuid()) @db.Uuid
  memoryId  String                    @map("memory_id") @db.Uuid
  embedding Unsupported("vector(1536)")?
  model     String
  metadata  Json                      @default("{}")
  createdAt DateTime                  @default(now()) @map("created_at")
  memory    Memory                    @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@map("memory_embeddings")
}

model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  isSensitive Boolean  @default(false) @map("is_sensitive")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model ResearchRun {
  id              String         @id @default(uuid()) @db.Uuid
  query           String
  mode            ResearchMode
  status          ResearchStatus @default(pending)
  provider        String
  model           String
  searchQueries   String[]       @default([]) @map("search_queries")
  summary         String         @default("")
  keyFindings     Json           @default("[]") @map("key_findings")
  recommendations Json           @default("[]")
  risks           Json           @default("[]")
  actionPlan      Json           @default("[]") @map("action_plan")
  warnings        String[]       @default([])
  errorMessage    String?        @map("error_message")
  startedAt       DateTime?      @map("started_at")
  completedAt     DateTime?      @map("completed_at")
  metadata        Json           @default("{}")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  sources         ResearchSource[]

  @@index([status, createdAt])
  @@index([mode, createdAt])
  @@map("research_runs")
}

model ResearchSource {
  id               String      @id @default(uuid()) @db.Uuid
  researchRunId    String      @map("research_run_id") @db.Uuid
  url              String
  normalizedUrl    String      @map("normalized_url")
  title            String
  domain           String
  snippet          String
  publishedAt      DateTime?   @map("published_at")
  retrievedAt      DateTime    @default(now()) @map("retrieved_at")
  sourceType       ResearchSourceType @map("source_type")
  citationMetadata Json        @default("{}") @map("citation_metadata")
  trusted          Boolean     @default(false)
  metadata         Json        @default("{}")
  researchRun      ResearchRun @relation(fields: [researchRunId], references: [id], onDelete: Cascade)

  @@index([researchRunId])
  @@index([normalizedUrl])
  @@map("research_sources")
}
