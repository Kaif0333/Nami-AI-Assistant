# Nami AI Assistant environment example
# Do not put real secrets in this file.

# App
APP_ENV=development
APP_NAME=Nami AI Assistant
APP_URL=http://localhost:3000
API_PORT=4000
# Comma-separated origins are supported.
WEB_DASHBOARD_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NAMI_SKIP_ENV_FILES=false

# AI provider
# Supported real providers are added progressively. Phase 3 supports Ollama.
AI_PROVIDER=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Future provider placeholders
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REALTIME_MODEL=

# Supabase / PostgreSQL
# DATABASE_URL and DATABASE_DIRECT_URL must be PostgreSQL connection strings.
# Do not paste SUPABASE_URL here.
# Local Docker example:
# postgresql://nami:<local-password>@localhost:55432/nami?schema=public
DATABASE_URL=
DATABASE_DIRECT_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MEMORY_EMBEDDING_MODEL=

# n8n
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
N8N_TEST_WEBHOOK_URL=

# Google integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# GitHub
GITHUB_TOKEN=

# Voice/TTS optional
ELEVENLABS_API_KEY=

# Weather / search optional
WEATHER_API_KEY=
SEARCH_API_KEY=

# Security
LOCAL_ENCRYPTION_KEY=
JWT_SECRET=
