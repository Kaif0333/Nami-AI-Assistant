# Nami AI Assistant environment example
# Do not put real secrets in this file.

# App
APP_ENV=development
APP_NAME=Nami AI Assistant
APP_URL=http://localhost:3000
API_PORT=4000
# Comma-separated origins are supported.
WEB_DASHBOARD_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NAMI_SKIP_ENV_FILES=false

# AI provider
# Supported real providers: ollama, gemini, groq, openrouter.
# OpenAI is reserved for a later approved phase.
AI_PROVIDER=
AI_DEFAULT_PROVIDER=groq
AI_DEFAULT_MODEL=llama-3.1-8b-instant
AI_FAST_PROVIDER=groq
AI_FAST_MODEL=llama-3.1-8b-instant
AI_CODING_PROVIDER=groq
AI_CODING_MODEL=llama-3.3-70b-versatile
AI_REASONING_PROVIDER=groq
AI_REASONING_MODEL=llama-3.3-70b-versatile
AI_RESEARCH_PROVIDER=gemini
AI_RESEARCH_MODEL=gemini-3.1-flash-lite
AI_LOCAL_PROVIDER=ollama
AI_LOCAL_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MODEL_CODING=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# Future provider placeholders
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REALTIME_MODEL=

# Supabase / PostgreSQL
# DATABASE_URL and DATABASE_DIRECT_URL must be PostgreSQL connection strings.
# Do not paste SUPABASE_URL here.
# Local Docker example:
# postgresql://nami:<local-password>@localhost:55432/nami?schema=public
DATABASE_URL=
DATABASE_DIRECT_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MEMORY_EMBEDDING_MODEL=

# n8n
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
N8N_TEST_WEBHOOK_URL=

# Google integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# GitHub
GITHUB_TOKEN=

# Voice/TTS optional
ELEVENLABS_API_KEY=

# Weather / search optional
WEATHER_API_KEY=
SEARCH_API_KEY=

# Security
LOCAL_ENCRYPTION_KEY=
JWT_SECRET=
