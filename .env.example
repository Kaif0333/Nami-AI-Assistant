# Nami AI Assistant environment example
# Do not put real secrets in this file.

# App
APP_ENV=development
APP_NAME=Nami AI Assistant
APP_URL=http://localhost:3000

# OpenAI
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.5
OPENAI_REASONING_MODEL=gpt-5.5-thinking
OPENAI_REALTIME_MODEL=

# Supabase / PostgreSQL
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# n8n
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
N8N_TEST_WEBHOOK_URL=

# Google integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# GitHub
GITHUB_TOKEN=

# Voice/TTS optional
ELEVENLABS_API_KEY=

# Weather / search optional
WEATHER_API_KEY=
SEARCH_API_KEY=

# Security
LOCAL_ENCRYPTION_KEY=
JWT_SECRET=
